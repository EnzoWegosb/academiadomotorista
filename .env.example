# Copie para `.env` (que o git ignora) e preencha. Nunca faça commit do .env.

# Projeto Supabase — Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave PUBLICÁVEL (sb_publishable_...) — é a única que vai para o HTML
SUPABASE_PUBLISHABLE_KEY=

# SÓ para os scripts de administração (aplica.py, exemplos.py, testes) — nunca no front-end
SUPABASE_SECRET_KEY=
# Personal Access Token do Supabase (Account → Access Tokens) — cria tabelas e publica a função
SUPABASE_ACCESS_TOKEN=

# senha da conta `supervisor` (exibida uma vez por `aplica.py supervisor`)
ACADEMIA_SUPERVISOR_SENHA=
# senha comum dos motoristas de exemplo e do `supervisor.exemplo`
ACADEMIA_SENHA_EXEMPLOS=
